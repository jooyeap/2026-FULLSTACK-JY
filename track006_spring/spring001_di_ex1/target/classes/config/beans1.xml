<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.3.xsd">
	
	<bean id="vanilla" class="com.company.ioc.Vanilla" />
	<bean id="chocolate" class="com.company.ioc.Chocolate"/>
	
	<bean id="iceCreamShop" class="com.company.ioc.IceCreamShop">
		<property name="shopName" value="bobo"/>
		<property name="iceCream" ref="chocolate"/>
	</bean>

</beans>
